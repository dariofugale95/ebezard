# === STACK/PROJECT ===
PROJECT_NAME=ebezard
COMPOSE_PROJECT_NAME=${PROJECT_NAME}-dev

# === DJANGO SUPERUSER CREDENTIALS ===
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=adminpass

# === DATABASE CONFIGURATION ===
DB_PORT_SOURCE=55432
DB_PORT_TARGET=5432
POSTGRES_DB=${PROJECT_NAME}
POSTGRES_USER=${PROJECT_NAME}
POSTGRES_PASSWORD=${PROJECT_NAME}

# === BACKEND SERVICE ===
BACKEND_PORT_SOURCE=8100
BACKEND_PORT_TARGET=8080
BACKEND_HOSTNAME=backend-dev
DEBUG=True
SECRET_KEY="django-insecure-CHANGE_ME"
ALLOWED_HOSTS=127.0.0.1,localhost,backend,backend-dev
DATABASE_URL=postgres://${PROJECT_NAME}:${PROJECT_NAME}@db-dev:${DB_PORT_TARGET}/${PROJECT_NAME}
BACKEND_BASE_URL=https://${BACKEND_HOSTNAME}:${BACKEND_PORT_TARGET}

# === FRONTEND SERVICE ===
FRONTEND_PORT_SOURCE=5180
FRONTEND_PORT_TARGET=5180
VITE_BACKEND_URL=https://localhost:${BACKEND_PORT_SOURCE}
VITE_FRONTEND_URL=https://localhost:${FRONTEND_PORT_SOURCE}
VITE_TEST_ENV=true
VITE_PROJECT_NAME=${PROJECT_NAME}

# === MARKETPLACE SERVICE ===
MARKETPLACE_PORT_SOURCE=8200
MARKETPLACE_PORT_TARGET=8200
MARKETPLACE_HOSTNAME=marketplace-dev
MARKETPLACE_BASE_URL=https://${MARKETPLACE_HOSTNAME}:${MARKETPLACE_PORT_TARGET}


# === API GATEWAY SERVICE ===
APIGATEWAY_PORT_SOURCE=8300
APIGATEWAY_PORT_TARGET=8000
API_GATEWAY_HOSTNAME=api-gateway-dev
VITE_API_GATEWAY_URL=https://localhost:${APIGATEWAY_PORT_SOURCE}

# === LANDING SERVICE ===
LANDING_PORT_SOURCE=8088
LANDING_PORT_TARGET=8088
LANDING_BASE_URL=https://localhost:${LANDING_PORT_TARGET}

# === SP SERVICE ===
SP_PORT_SOURCE=8500
SP_PORT_TARGET=8500
SP_HOSTNAME=sp-dev
SP_BASE_URL=https://${SP_HOSTNAME}:${SP_PORT_TARGET}

 # === AUTH SERVICE ===
AUTH_PORT_SOURCE=8003
AUTH_PORT_TARGET=8003
AUTH_HOSTNAME=auth-dev
OAUTH_CLIENT_ID=your_oauth_client_id_here
OAUTH_CLIENT_SECRET=your_oauth_client_secret_here
OIDC_RSA_PRIVATE_KEY_PATH=/app/oidc_rsa_private_key.pem
OAUTH_AUTHORIZE_URL=https://localhost:${AUTH_PORT_SOURCE}/o/authorize/
OAUTH_REDIRECT_URI=https://localhost:${LANDING_PORT_SOURCE}/post-register-redirect
OAUTH_POST_LOGOUT_REDIRECT_URI=https://localhost:${LANDING_PORT_SOURCE}/
AUTH_DEBUG=True
AUTH_SECRET_KEY="django-insecure-CHANGE_ME"
ALLOWED_HOSTS_AUTH=127.0.0.1,localhost,auth,auth-dev,api-gateway,api-gateway-dev
AUTH_BASE_URL=https://${AUTH_HOSTNAME}:${AUTH_PORT_TARGET}
AUTH_BASE_URL_PUBLIC=https://localhost:${AUTH_PORT_TARGET}

# Django superuser for Auth service
AUTH_DJANGO_SUPERUSER_USERNAME=admin_auth
AUTH_DJANGO_SUPERUSER_EMAIL=admin_auth@example.com
AUTH_DJANGO_SUPERUSER_PASSWORD=adminpass_auth

# === AUTH SERVICE DATABASE ===
AUTH_DB_PORT_SOURCE=55433
AUTH_DB_PORT_TARGET=5433
AUTH_DB_NAME=ebezard_auth
AUTH_DB_USER=ebezard_auth
AUTH_DB_PASSWORD=ebezard_auth

# Connection string for Auth service (used ONLY by ebezard-auth)
AUTH_DATABASE_URL=postgres://${AUTH_DB_USER}:${AUTH_DB_PASSWORD}@db-auth:${AUTH_DB_PORT_TARGET}/${AUTH_DB_NAME}
# Allowed origins for API Gateway CORS (dev)
ALLOWED_ORIGINS_GATEWAY=https://localhost:${FRONTEND_PORT_SOURCE},https://localhost:${LANDING_PORT_SOURCE},https://localhost:${MARKETPLACE_PORT_SOURCE},https://localhost:${SP_PORT_SOURCE},https://localhost:${BACKEND_PORT_SOURCE},https://localhost:${APIGATEWAY_PORT_SOURCE}

# === REDIS CONFIGURATION ===
REDIS_PORT_SOURCE=6379
REDIS_PORT_TARGET=6379
REDIS_HOSTNAME=redis-dev
REDIS_URL=redis://${REDIS_HOSTNAME}:${REDIS_PORT_SOURCE}/0

# === NGINX API Gateway ===
NGINX_APIGATEWAY_HOST=apigateway-nginx
NGINX_APIGATEWAY_PORT_SOURCE=8300
NGINX_APIGATEWAY_PORT_TARGET=443
NGINX_APIGATEWAY_CERT_PATH=/etc/nginx/certs/apigateway-cert.pem
NGINX_APIGATEWAY_KEY_PATH=/etc/nginx/certs/apigateway-key.pem
NGINX_APIGATEWAY_CA_PATH=/etc/nginx/certs/ca-cert.pem

# === NGINX Backend ===
NGINX_BACKEND_HOST=backend-nginx
NGINX_BACKEND_PORT_SOURCE=8100
NGINX_BACKEND_PORT_TARGET=443
NGINX_BACKEND_CERT_PATH=/etc/nginx/certs/backend-cert.pem
NGINX_BACKEND_KEY_PATH=/etc/nginx/certs/backend-key.pem
NGINX_BACKEND_CA_PATH=/etc/nginx/certs/ca-cert.pem

# === NGINX Auth ===
NGINX_AUTH_HOST=auth-nginx
NGINX_AUTH_PORT_SOURCE=8003
NGINX_AUTH_PORT_TARGET=443
NGINX_AUTH_CERT_PATH=/etc/nginx/certs/auth-cert.pem
NGINX_AUTH_KEY_PATH=/etc/nginx/certs/auth-key.pem
NGINX_AUTH_CA_PATH=/etc/nginx/certs/ca-cert.pem

# === NGINX Frontend ===
NGINX_FRONTEND_HOST=frontend-nginx
NGINX_FRONTEND_PORT_SOURCE=5180
NGINX_FRONTEND_PORT_TARGET=443
NGINX_FRONTEND_CERT_PATH=/etc/nginx/certs/frontend-cert.pem
NGINX_FRONTEND_KEY_PATH=/etc/nginx/certs/frontend-key.pem
NGINX_FRONTEND_CA_PATH=/etc/nginx/certs/ca-cert.pem

# === NGINX Landing ===
NGINX_LANDING_HOST=landing-nginx
NGINX_LANDING_PORT_SOURCE=8088
NGINX_LANDING_PORT_TARGET=443
NGINX_LANDING_CERT_PATH=/etc/nginx/certs/landing-cert.pem
NGINX_LANDING_KEY_PATH=/etc/nginx/certs/landing-key.pem
NGINX_LANDING_CA_PATH=/etc/nginx/certs/ca-cert.pem

# === NGINX Marketplace ===
NGINX_MARKETPLACE_HOST=marketplace-nginx
NGINX_MARKETPLACE_PORT_SOURCE=8200
NGINX_MARKETPLACE_PORT_TARGET=443
NGINX_MARKETPLACE_CERT_PATH=/etc/nginx/certs/marketplace-cert.pem
NGINX_MARKETPLACE_KEY_PATH=/etc/nginx/certs/marketplace-key.pem
NGINX_MARKETPLACE_CA_PATH=/etc/nginx/certs/ca-cert.pem

# === NGINX SP ===
NGINX_SP_HOST=sp-nginx
NGINX_SP_PORT_SOURCE=8500
NGINX_SP_PORT_TARGET=443
NGINX_SP_CERT_PATH=/etc/nginx/certs/sp-cert.pem
NGINX_SP_KEY_PATH=/etc/nginx/certs/sp-key.pem
NGINX_SP_CA_PATH=/etc/nginx/certs/ca-cert.pem